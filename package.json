{
  "name": "ecommerce-swag-labs-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Automatizacion E2E de Swag Labs con Playwright, Cucumber y Page Object Model.",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:ci": "bddgen && playwright test --project=chromium",
    "test:open": "bddgen && playwright test --ui",
    "test:ui:chromium": "bddgen && playwright test --ui --project=chromium --ui-host=localhost --ui-port=0",
    "test:headed": "bddgen && playwright test --project=chromium --headed",
    "test:debug": "bddgen && playwright test --project=chromium --debug",
    "test:login": "bddgen && playwright test --grep @login",
    "test:shopping-cart": "bddgen && playwright test --grep @shoppingCart",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "quality": "npm run format:check && npm run lint && npm run typecheck"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "e2e",
    "pom"
  ],
  "author": "Matias Nahuel Murua Martinez",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright-bdd": "9.2.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
