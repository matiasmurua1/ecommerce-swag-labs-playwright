{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "pages/**/*.ts",
    "steps_definitions/**/*.ts",
    "support/**/*.ts",
    "playwright.config.ts"
  ]
}
